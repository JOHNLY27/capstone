datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum OrderType {
  PABILI
  PAHATOD
  PAKUHA
  PASUGO
}

enum TransactionType {
  TOPUP
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String    @unique
  role         UserRole
  walletBalance Decimal   @default(0.00) @db.Decimal(10, 2)
  avatar       String?
  rating       Float     @default(5.0)
  ratingsCount Int       @default(0)
  isVerified   Boolean   @default(false)
  settings     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ordersAsCustomer Order[]             @relation("CustomerOrders")
  ordersAsRider    Order[]             @relation("RiderOrders")
  transactions     WalletTransaction[]
  riderDocuments   RiderDocument[]
  sentMessages     ChatMessage[]       @relation("SenderMessages")
  receivedMessages ChatMessage[]       @relation("ReceiverMessages")
  location         RiderLocation?
  favoritesAsCustomer FavoriteRider[] @relation("CustomerFavorites")
  favoritesAsRider    FavoriteRider[] @relation("RiderFavorites")
  savedAddresses   SavedAddress[]
  sentSupportMessages     SupportMessage[] @relation("SenderSupportMessages")
  receivedSupportMessages SupportMessage[] @relation("ReceiverSupportMessages")
}

model RiderDocument {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber  String
  plateNumber    String
  vehicleModel   String
  licenseImage   String?
  clearanceImage String?
  status         DocumentStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Order {
  id                String       @id @default(uuid())
  type              OrderType
  status            OrderStatus  @default(PENDING)
  customerId        String
  customer          User         @relation("CustomerOrders", fields: [customerId], references: [id])
  riderId           String?
  rider             User?        @relation("RiderOrders", fields: [riderId], references: [id])
  pickupAddress     String
  dropoffAddress    String
  pickupCoords      Json         // e.g. { "latitude": 14.5995, "longitude": 120.9842 }
  dropoffCoords     Json         // e.g. { "latitude": 14.6010, "longitude": 120.9855 }
  estimatedDistance Float        // in km
  price             Decimal      @default(0.00) @db.Decimal(10, 2) // for items purchased (e.g. Pabili)
  deliveryFee       Decimal      @default(0.00) @db.Decimal(10, 2)
  details           Json?        // e.g. custom items lists: [ { "item": "Bread", "qty": 2 } ]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  transactions WalletTransaction[]
  chatMessages ChatMessage[]
}

model WalletTransaction {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          TransactionType
  amount        Decimal           @db.Decimal(10, 2)
  status        TransactionStatus @default(PENDING)
  referenceCode String            @unique
  description   String
  createdAt     DateTime          @default(now())
}

model ChatMessage {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("SenderMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceiverMessages", fields: [receiverId], references: [id])
  message    String
  createdAt  DateTime @default(now())
}

model RiderLocation {
  riderId   String   @id
  rider     User     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  bearing   Float?
  updatedAt DateTime @updatedAt
}

model FavoriteRider {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  riderId    String
  rider      User     @relation("RiderFavorites", fields: [riderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, riderId])
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // e.g. "Home", "Work", "Parents House"
  address   String
  details   String?  // e.g. "Near the blue gate"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SenderSupportMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceiverSupportMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime @default(now())
}

